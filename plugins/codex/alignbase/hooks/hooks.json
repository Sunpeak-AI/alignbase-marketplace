{
  "description": "Load Alignbase context when a Codex session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/session-start.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\session-start.ps1\"",
            "timeout": 10,
            "statusMessage": "Checking Alignbase startup"
          }
        ]
      }
    ]
  }
}
